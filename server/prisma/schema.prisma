datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TRADER
  MENTOR
  MODERATOR
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum ThemePreference {
  light
  dark
  system
}

enum Direction {
  BUY
  SELL
}

enum TradeResult {
  WIN
  LOSS
  BREAKEVEN
  OPEN
}

enum TradeStatus {
  PLANNED
  ACTIVE
  CLOSED
  CANCELLED
}

enum TradingSession {
  ASIAN
  LONDON
  NEW_YORK
  LONDON_NEW_YORK_OVERLAP
  OTHER
}

enum TradeGrade {
  A_PLUS
  A
  B
  C
  D
  MISTAKE
}

enum ScreenshotType {
  HIGHER_TIMEFRAME_ANALYSIS
  BEFORE_ENTRY
  ENTRY
  DURING_TRADE
  EXIT
  POST_ANALYSIS
  MARKED_CHART
}

enum EmotionStage {
  BEFORE_TRADE
  DURING_TRADE
  AFTER_TRADE
}

enum Emotion {
  CALM
  CONFIDENT
  ANXIOUS
  GREEDY
  FEARFUL
  ANGRY
  FOMO
  REVENGE_MINDSET
  DISCIPLINED
  REGRETFUL
  FRUSTRATED
}

enum ViolationSeverity {
  MINOR
  MODERATE
  MAJOR
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  MENTOR
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionSource {
  PAYMENT
  PROMOTION
  ADMIN
  GIFT
  REFERRAL
}

enum SubscriptionReason {
  PROMOTION_EXPIRED
  ADMIN_GRANTED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  PROMOTION_REDEEMED
  REFERRAL_REWARD
  INITIAL_SIGNUP
}

enum PromotionCategory {
  LAUNCH
  REFERRAL
  GIFT
  COUPON
  BETA
  INTERNAL
  MARKETING
  PARTNERSHIP
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum AiFeatureType {
  TRADE_REVIEW
  WEEKLY_COACH
  EDGE_FINDER
  TRADING_PLAN
  SCREENSHOT_REVIEW
  JOURNAL_ASSISTANT
  ANALYTICS_ASSISTANT
  MENTOR_SUMMARY
  SUPPORT_ASSISTANT
}

enum AiRequestStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AccountCategory {
  REGULAR
  PROP_FIRM
}

enum PropFirmMarketType {
  FOREX_CFD
  FUTURES
  OTHER
}

enum EvaluationType {
  ONE_STEP
  TWO_STEP
  THREE_STEP
  INSTANT_FUNDED
  ALREADY_FUNDED
  FREE_TRIAL
  DEMO_EVALUATION
}

enum PropFirmAccountStatus {
  NOT_STARTED
  ACTIVE
  PASSED
  FAILED
  BREACHED
  FUNDED
  SUSPENDED
  RESET
  EXPIRED
}

enum DrawdownType {
  STATIC
  TRAILING
  END_OF_DAY_TRAILING
  INTRADAY_TRAILING
  ABSOLUTE
}

enum PropFirmPhaseStatus {
  NOT_STARTED
  ACTIVE
  PASSED
  FAILED
  RESET
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role   @default(TRADER)

  country           String?
  timezone          String?
  phoneNumber       String?
  tradingExperience String?
  mainTradingPairs  String[]
  mainSession       String?
  tradingStyle      String?

  subscriptionPlan           SubscriptionPlan   @default(FREE)
  subscriptionStatus         SubscriptionStatus @default(ACTIVE)
  onboardingCompleted        Boolean            @default(false)
  isDisabled                 Boolean            @default(false)
  emailVerified              Boolean            @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  passwordResetUsedAt        DateTime?
  tokenVersion               Int                @default(0)

  avatarUrl      String?
  avatarPublicId String?

  tradingAccounts    TradingAccount[]
  tradeRules         TradeRule[]
  importedTradeFiles ImportedTradeFile[]
  weeklyReviews      WeeklyReview[]
  tradingGoals       TradingGoal[]
  reportExports      ReportExport[]
  subscriptions      Subscription[]
  payments           Payment[]
  contactMessages         ContactMessage[] @relation("UserContactMessages")
  assignedContactMessages ContactMessage[] @relation("AssignedContactMessages")
  supportTickets          SupportTicket[]
  bugReports         BugReport[]
  featureRequests    FeatureRequest[]
  internalNotes      InternalNote[]
  mentorGroups       MentorStudent[]     @relation("StudentGroups")
  ownedMentorGroups  MentorGroup[]       @relation("MentorGroups")
  mentorFeedbacks    MentorFeedback[]    @relation("FeedbacksGiven")
  aiRequests         AiRequest[]
  userSettings       UserSettings?
  strategies         Strategy[]
  notificationRecipients NotificationRecipient[]
  authoredContactNotes   ContactInternalNote[] @relation("ContactNoteAuthor")

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  subscriptionHistories SubscriptionHistory[]
  userBadges            UserBadge[]

  @@index([timezone])
}

model UserSettings {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  theme                 ThemePreference @default(system)
  dashboardDensity      String          @default("comfortable")
  tradeTableDensity     String          @default("comfortable")
  chartAnimations       Boolean         @default(true)
  preferredDateFormat   String?         @default("DD/MM/YYYY")
  preferredNumberFormat String?         @default("1,234.56")

  defaultTradingAccountId String?
  defaultRiskPercent      Float?
  minimumRiskRewardRatio  Float?
  defaultHigherTimeframe  String?
  defaultEntryTimeframe   String?
  mainStrategy            String?
  mainPairs               String?
  preferredSession        String?
  maxTradesPerDay         Int?
  maxLossesPerDay         Int?
  dailyLossLimit          Float?

  defaultTradeGrade                 String?
  requireScreenshotBeforeCompletion Boolean  @default(false)
  requirePostTradeNotes             Boolean  @default(false)
  requireEmotionTracking            Boolean  @default(false)
  requireRuleChecklist              Boolean  @default(false)
  showOpenTradesFirst               Boolean  @default(true)
  defaultTradeListView              String   @default("table")
  defaultAnalyticsPeriod            String   @default("30d")
  requiredTradeFields               String[] @default(["pair", "direction", "entryPrice", "stopLoss", "takeProfit"])

  defaultScreenshotType           String  @default("MARKED_CHART")
  defaultScreenshotQuality        String  @default("high")
  maximumScreenshotsPerTrade      Int     @default(6)
  automaticallyCompressImages     Boolean @default(true)
  keepOriginalImage               Boolean @default(false)
  deleteCloudinaryImagesWithTrade Boolean @default(true)

  enableAiTradeReviews     Boolean @default(false)
  generateReviewAfterClose Boolean @default(false)
  includeEmotions          Boolean @default(true)
  includeRuleViolations    Boolean @default(true)
  includeScreenshots       Boolean @default(false)
  weeklyAiSummary          Boolean @default(false)
  coachingTone             String  @default("analytical")

  assignedMentor        String?
  shareTradesWithMentor Boolean @default(false)
  shareScreenshots      Boolean @default(false)
  shareEmotions         Boolean @default(false)
  shareWeeklyReviews    Boolean @default(false)
  allowMentorComments   Boolean @default(true)

  weeklyReviewReminders       Boolean @default(false)
  dailyJournalingReminders    Boolean @default(false)
  tradeFollowUpReminders      Boolean @default(false)
  riskLimitWarnings           Boolean @default(false)
  propFirmDrawdownWarnings    Boolean @default(false)
  mentorFeedbackNotifications Boolean @default(false)
  productUpdates              Boolean @default(false)
  emailNotifications          Boolean @default(false)
  inAppNotifications          Boolean @default(true)

  riskPerTrade               Float?
  dailyDrawdownLimit         Float?
  weeklyDrawdownLimit        Float?
  maximumOpenTrades          Int?
  stopAfterLosses            Int?
  warnRiskAboveLimit         Boolean @default(false)
  warnRiskRewardBelowMinimum Boolean @default(false)

  loginAlerts Boolean @default(false)

  billingEmail     String?
  renewalReminders Boolean @default(false)

  enableJahzAi            Boolean @default(true)
  allowTradeDataAnalysis  Boolean @default(true)
  allowAiUseOfJournalData Boolean @default(false)
  allowScreenshotAnalysis Boolean @default(false)
  aiLanguage              String  @default("english")
  saveAiHistory           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradingAccount {
  id                  String          @id @default(uuid())
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  name                String
  accountCategory     AccountCategory @default(REGULAR)
  brokerName          String?
  accountType         String?
  startingBalance     Float
  currentBalance      Float
  currency            String          @default("USD")
  platform            String?
  defaultRiskPercent  Float?
  riskPerTradePercent Float?
  maxDailyLossPercent Float?
  maxTradesPerDay     Int?
  maxLossesPerDay     Int?
  notes               String?
  isPropFirmAccount   Boolean         @default(false)
  propFirmName        String?
  profitTarget        Float?
  maxDrawdown         Float?
  dailyDrawdown       Float?
  minimumTradingDays  Int?

  trades          Trade[]
  weeklyReviews   WeeklyReview[]
  propFirmAccount PropFirmAccount?
  tradingGoals    TradingGoal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, accountCategory])
}

model PropFirmAccount {
  id                          String                @id @default(uuid())
  tradingAccount              TradingAccount        @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  tradingAccountId            String                @unique
  firmName                    String
  customFirmName              String?
  programmeName               String
  marketType                  PropFirmMarketType
  evaluationType              EvaluationType
  accountStatus               PropFirmAccountStatus @default(NOT_STARTED)
  platform                    String?
  brokerServer                String?
  challengeFee                Float?
  startDate                   DateTime?
  currentPhaseNumber          Int?
  dailyLossEnabled            Boolean               @default(true)
  dailyLossPercent            Float?
  dailyLossAmount             Float?
  maximumLossPercent          Float?
  maximumLossAmount           Float?
  drawdownType                DrawdownType?
  dailyLossCalculationBasis   String?
  overallLossCalculationBasis String?
  includeFloatingPnl          Boolean               @default(true)
  includeCommissions          Boolean               @default(true)
  includeSwaps                Boolean               @default(true)
  dailyResetTime              String?
  dailyResetTimezone          String?
  maxRiskPerTradePercent      Float?
  maxRiskPerTradeIdea         Float?
  maxOpenPositions            Int?
  maxLotSize                  Float?
  stopAfterLosses             Int?
  consistencyRuleEnabled      Boolean               @default(false)
  consistencyRuleType         String?
  consistencyThreshold        Float?
  maximumBestDayPercent       Float?
  minimumProfitableDays       Int?
  profitableDayMinimum        Float?
  newsTradingAllowed          Boolean?
  weekendHoldingAllowed       Boolean?
  overnightHoldingAllowed     Boolean?
  expertAdvisorsAllowed       Boolean?
  copyTradingAllowed          Boolean?
  hedgingAllowed              Boolean?
  scalpingAllowed             Boolean?
  cryptoTradingAllowed        Boolean?
  restrictedSymbols           String[]
  restrictedNewsBeforeMinutes Int?
  restrictedNewsAfterMinutes  Int?
  maximumInactivityDays       Int?
  prohibitedStrategies        String?
  customRules                 String?
  profitSplitPercent          Float?
  firstPayoutDate             DateTime?
  payoutFrequency             String?
  minimumPayoutAmount         Float?
  payoutCycleStartDate        DateTime?
  scalingPlanEnabled          Boolean               @default(false)
  nextScalingTarget           Float?
  maximumAllocation           Float?

  phases            PropFirmPhase[]
  progressSnapshots PropFirmProgressSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradingAccountId])
  @@index([firmName])
  @@index([accountStatus])
}

model PropFirmPhase {
  id                    String              @id @default(uuid())
  propFirmAccount       PropFirmAccount     @relation(fields: [propFirmAccountId], references: [id], onDelete: Cascade)
  propFirmAccountId     String
  phaseNumber           Int
  name                  String
  profitTargetPercent   Float?
  profitTargetAmount    Float?
  minimumTradingDays    Int?
  minimumProfitableDays Int?
  maximumTradingDays    Int?
  timeLimitType         String?
  timeLimitDays         Int?
  status                PropFirmPhaseStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propFirmAccountId, phaseNumber])
  @@index([propFirmAccountId])
}

model PropFirmProgressSnapshot {
  id                   String          @id @default(uuid())
  propFirmAccount      PropFirmAccount @relation(fields: [propFirmAccountId], references: [id], onDelete: Cascade)
  propFirmAccountId    String
  balance              Float
  equity               Float?
  dailyProfitLoss      Float?
  overallProfitLoss    Float?
  completedTradingDays Int             @default(0)
  profitableDays       Int             @default(0)
  bestDayProfit        Float?
  recordedAt           DateTime        @default(now())

  @@index([propFirmAccountId, recordedAt])
}

model TradingGoal {
  id               String          @id @default(cuid())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  tradingAccount   TradingAccount? @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  tradingAccountId String?
  periodType       GoalPeriod
  profitTarget     Decimal?
  tradeCountTarget Int?
  winRateTarget    Decimal?
  maxLossTarget    Decimal?
  active           Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active, periodType])
  @@index([tradingAccountId])
}

model Trade {
  id                String          @id @default(uuid())
  tradingAccount    TradingAccount  @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  tradingAccountId  String
  pair              String
  direction         Direction
  entryPrice        Float?
  stopLoss          Float?
  takeProfit        Float?
  exitPrice         Float?
  lotSize           Float?
  riskAmount        Float?
  rewardAmount      Float?
  profitLossAmount  Float?
  profitLossPercent Float?
  riskRewardRatio   Float?
  pips              Float?
  result            TradeResult     @default(OPEN)
  status            TradeStatus     @default(PLANNED)
  session           TradingSession?
  strategyId        String?
  strategy          Strategy?       @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  setupId           String?
  setup             Setup?          @relation(fields: [setupId], references: [id], onDelete: SetNull)
  higherTimeframe   String?
  entryTimeframe    String?
  htfBias           String?
  entryReason       String?
  exitReason        String?
  notesBefore       String?
  notesAfter        String?
  followedPlan      Boolean?
  isAPlusSetup      Boolean?
  newsRelated       Boolean?
  grade             TradeGrade?
  entryTime         DateTime?
  exitTime          DateTime?

  screenshots          TradeScreenshot[]
  ruleViolations       TradeRuleViolation[]
  emotionLogs          EmotionLog[]
  aiReviews            AiTradeReview[]
  mentorFeedbacks      MentorFeedback[]
  checklistResponses   TradeChecklistResponse[]
  bestInWeeklyReviews  WeeklyReview[]           @relation("WeeklyReviewBestTrade")
  worstInWeeklyReviews WeeklyReview[]           @relation("WeeklyReviewWorstTrade")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradingAccountId])
  @@index([tradingAccountId, entryTime])
  @@index([entryTime])
  @@index([exitTime])
  @@index([pair])
  @@index([result])
  @@index([session])
  @@index([strategyId])
  @@index([setupId])
  @@index([direction])
  @@index([entryTimeframe])
  @@index([followedPlan])
  @@index([isAPlusSetup])
  @@index([newsRelated])
}

model TradeScreenshot {
  id             String         @id @default(uuid())
  trade          Trade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId        String
  screenshotType ScreenshotType
  imageUrl       String
  publicId       String?
  width          Int?
  height         Int?
  format         String?
  fileSize       Int?
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeId])
}

model TradeRule {
  id          String  @id @default(uuid())
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  description String?
  active      Boolean @default(true)

  violations TradeRuleViolation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, active])
}

model TradeRuleViolation {
  id          String            @id @default(uuid())
  trade       Trade             @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId     String
  tradeRule   TradeRule         @relation(fields: [tradeRuleId], references: [id], onDelete: Cascade)
  tradeRuleId String
  severity    ViolationSeverity
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeId])
  @@index([tradeRuleId])
}

model EmotionLog {
  id        String       @id @default(uuid())
  trade     Trade        @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId   String
  stage     EmotionStage
  emotion   Emotion
  intensity Int // 1 to 10
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeId])
  @@index([emotion])
  @@index([stage])
}

model ImportedTradeFile {
  id           String       @id @default(uuid())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  source       String
  fileName     String
  filePath     String
  fileType     String
  status       ImportStatus @default(PENDING)
  processedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyReview {
  id                            String          @id @default(uuid())
  user                          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                        String
  tradingAccount                TradingAccount? @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  tradingAccountId              String?
  scopeKey                      String          @default("all")
  weekStartDate                 DateTime
  weekEndDate                   DateTime
  totalTrades                   Int             @default(0)
  wins                          Int             @default(0)
  losses                        Int             @default(0)
  breakevens                    Int             @default(0)
  winRate                       Float           @default(0)
  netProfitLoss                 Float           @default(0)
  grossProfit                   Float           @default(0)
  grossLoss                     Float           @default(0)
  profitFactor                  Float?
  expectancy                    Float?
  averageWin                    Float?
  averageLoss                   Float?
  averageRiskReward             Float?
  bestTrade                     Trade?          @relation("WeeklyReviewBestTrade", fields: [bestTradeId], references: [id], onDelete: SetNull)
  bestTradeId                   String?
  worstTrade                    Trade?          @relation("WeeklyReviewWorstTrade", fields: [worstTradeId], references: [id], onDelete: SetNull)
  worstTradeId                  String?
  bestPair                      String?
  worstPair                     String?
  bestSession                   String?
  worstSession                  String?
  bestSetup                     String?
  worstSetup                    String?
  biggestMistake                String?
  mostCommonEmotion             String?
  mostBrokenRule                String?
  mainLesson                    String?
  mainMistake                   String?
  personalLesson                String?
  nextWeekFocus                 String?
  generalReflection             String?
  additionalNotes               String?
  aPlusSetupWinRate             Float?
  newsRelatedWinRate            Float?
  planFollowingRate             Float?
  disciplineScore               Int?
  disciplineScoreFormulaVersion String?
  disciplineScoreComponents     Json?
  aiSummary                     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scopeKey, weekStartDate])
  @@index([userId])
  @@index([weekStartDate])
  @@index([userId, weekStartDate])
  @@index([tradingAccountId, weekStartDate])
}

model ReportExport {
  id          String    @id @default(uuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  reportType  String
  periodStart DateTime?
  periodEnd   DateTime?
  fileName    String
  filePath    String
  status      String    @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiTradeReview {
  id                 String    @id @default(uuid())
  trade              Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId            String
  summary            String?
  mistakes           String?
  strengths          String?
  ruleFeedback       String?
  psychologyFeedback String?
  riskFeedback       String?
  recommendation     String?
  disciplineScore    Int?
  rawResponse        String?
  provider           String?
  modelUsed          String?
  promptVersion      String?
  generatedAt        DateTime?
  inputSnapshot      Json?
  structuredOutput   Json?
  tokenUsage         Json?
  reviewStatus       String    @default("COMPLETED")
  errorMessage       String?
  retryCount         Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeId])
}

model AiRequest {
  id               String          @id @default(cuid())
  userId           String
  tradeId          String?
  weeklyReviewId   String?
  mentorGroupId    String?
  featureType      AiFeatureType
  status           AiRequestStatus @default(QUEUED)
  provider         String
  model            String
  promptVersion    String
  inputSnapshot    Json?
  structuredOutput Json?
  rawResponse      Json?
  errorMessage     String?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCost    Decimal?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, featureType, createdAt])
  @@index([status, createdAt])
}

model MentorGroup {
  id          String  @id @default(uuid())
  mentor      User    @relation("MentorGroups", fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId    String
  name        String
  description String?

  students MentorStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorStudent {
  id            String      @id @default(uuid())
  mentorGroup   MentorGroup @relation(fields: [mentorGroupId], references: [id], onDelete: Cascade)
  mentorGroupId String
  student       User        @relation("StudentGroups", fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  status        String      @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MentorFeedback {
  id             String  @id @default(uuid())
  mentor         User    @relation("FeedbacksGiven", fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId       String
  trade          Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId        String
  feedback       String
  grade          String?
  recommendation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id               String             @id @default(uuid())
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  plan             SubscriptionPlan
  status           SubscriptionStatus @default(ACTIVE)
  source           SubscriptionSource @default(PAYMENT)
  autoRenew        Boolean            @default(false)
  paymentReference String?

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  startedAt DateTime  @default(now())
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  amount    Float
  currency  String    @default("USD")
  provider  String
  reference String    @unique
  status    String
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Strategy {
  id                 String  @id @default(uuid())
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  name               String
  description        String?
  style              String?
  market             String?
  defaultRiskPercent Float?
  isActive           Boolean @default(true)
  isArchived         Boolean @default(false)
  isImported         Boolean @default(false)

  setups Setup[]
  trades Trade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isArchived])
}

model Setup {
  id                  String   @id @default(uuid())
  strategy            Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyId          String
  name                String
  description         String?
  preferredSession    String?
  preferredTimeframes String[]
  minimumRR           Float?
  maximumRisk         Float?
  exampleImage        String?
  notes               String?
  isActive            Boolean  @default(true)
  isArchived          Boolean  @default(false)
  isImported          Boolean  @default(false)
  sortOrder           Int      @default(0)

  checklistItems ChecklistItem[]
  trades         Trade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([strategyId])
}

model ChecklistItem {
  id          String  @id @default(uuid())
  setup       Setup   @relation(fields: [setupId], references: [id], onDelete: Cascade)
  setupId     String
  title       String
  description String?
  category    String?
  required    Boolean @default(false)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  responses TradeChecklistResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([setupId])
}

model TradeChecklistResponse {
  id              String        @id @default(uuid())
  trade           Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId         String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  checklistItemId String
  checked         Boolean       @default(false)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tradeId, checklistItemId])
  @@index([tradeId])
}

model Promotion {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  planGranted SubscriptionPlan
  benefits    String[]         @default([])

  badgeId String?
  badge   Badge?  @relation(fields: [badgeId], references: [id], onDelete: SetNull)

  category           PromotionCategory @default(MARKETING)
  isActive           Boolean   @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  maxRedemptions     Int?
  currentRedemptions Int       @default(0)
  requiresInvite     Boolean   @default(false)
  autoActivate       Boolean   @default(false)
  autoExpire         Boolean   @default(false)
  revokeBadgeOnExpiry Boolean  @default(false)

  subscriptions Subscription[]
  histories     SubscriptionHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionHistory {
  id           String              @id @default(uuid())
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  previousPlan SubscriptionPlan?
  newPlan      SubscriptionPlan
  source       SubscriptionSource
  reason       SubscriptionReason?

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  paymentReference String?
  changedBy        String  @default("USER")

  createdAt DateTime @default(now())
}

model Badge {
  id          String  @id @default(uuid())
  name        String  @unique
  color       String  @default("gold")
  icon        String?
  description String?

  promotions Promotion[]
  users      UserBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserBadge {
  id      String @id @default(uuid())
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId String

  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  action     String
  resource   String?
  resourceId String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model SupportTicket {
  id          String   @id @default(uuid())
  ticketNumber String  @unique @default(uuid())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId      String?
  subject     String
  description String
  category    String   @default("GENERAL")
  status      String   @default("OPEN")
  priority    String   @default("NORMAL")
  assignedTo  String?
  rating      Int?
  feedback    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([ticketNumber])
}

model SystemConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model BugReport {
  id            String   @id @default(uuid())
  reporter      User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId    String?
  browser       String?
  device        String?
  appVersion    String?
  severity      String   @default("NORMAL")
  status        String   @default("NEW")
  assignedTo    String?
  relatedModule String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([reporterId])
  @@index([status])
}

model FeatureRequest {
  id               String   @id @default(uuid())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId           String?
  category         String   @default("GENERAL")
  description      String
  votes            Int      @default(0)
  status           String   @default("UNDER_REVIEW")
  estimatedRelease String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model InternalNote {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  content   String
  authorId  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id           String   @id @default(uuid())
  type         String   @default("SYSTEM")
  category     String   @default("INFO")
  title        String
  message      String
  actionUrl    String?
  targetUsers  String[]
  targetRoles  String[]
  isGlobal     Boolean  @default(false)
  senderId     String?
  expiresAt    DateTime?
  
  recipients   NotificationRecipient[]

  createdAt    DateTime @default(now())
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  status         String       @default("UNREAD")
  readAt         DateTime?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([notificationId, userId])
  @@index([userId, status])
}

model Announcement {
  id                String    @id @default(uuid())
  title             String
  content           String
  targetAudiences   String[]  @default(["ALL"])
  displayLocations  String[]  @default(["DASHBOARD"])
  priority          String    @default("NORMAL")
  status            String    @default("DRAFT")
  startsAt          DateTime?
  endsAt            DateTime?
  createdBy         String?
  views             Int       @default(0)
  clicks            Int       @default(0)
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
  @@index([startsAt, endsAt])
}

model ContactMessage {
  id           String  @id @default(uuid())
  user         User?   @relation("UserContactMessages", fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
  assignedTo   User?   @relation("AssignedContactMessages", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  name         String
  email        String
  subject      String
  message      String
  status       String  @default("NEW")
  tags         String[] @default([])
  ipHash       String?

  threads       ContactThread[]
  internalNotes ContactInternalNote[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([userId])
}

model ContactThread {
  id               String         @id @default(uuid())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  contactMessageId String
  senderType       String
  senderId         String?
  message          String
  attachments      String[]
  
  createdAt        DateTime       @default(now())

  @@index([contactMessageId])
}

model ContactInternalNote {
  id               String         @id @default(uuid())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  contactMessageId String
  author           User           @relation("ContactNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId         String
  content          String

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([contactMessageId])
  @@index([authorId])
}


